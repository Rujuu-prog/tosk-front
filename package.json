  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
