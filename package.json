    "@mantine/dates": "^8.2.7",
    "@mantine/form": "^8.2.7",
    "@mantine/hooks": "^8.2.7",
    "@mantine/modals": "^8.2.7",
    "@mantine/notifications": "^8.2.7",
    "@mantine/nprogress": "^8.2.7",
    "@mantine/spotlight": "^8.2.7",
    "@mantine/tiptap": "^8.2.7",
    "@tiptap/extension-link": "^3.3.0",
    "@tiptap/pm": "^3.3.0",
    "@tiptap/react": "^3.3.0",
    "@tiptap/starter-kit": "^3.3.0",
